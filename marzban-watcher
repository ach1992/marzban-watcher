#!/usr/bin/env bash
set -euo pipefail

APP="Marzban Watcher"
SERVICE="marzban-watcher"
ENV_FILE="/etc/marzban-watcher.env"
LATEST_FILE="/var/lib/marzban-watcher/latest_report.txt"
HOURLY_FILE="/var/lib/marzban-watcher/hourly_suspicious.jsonl"
LOG_FILE="/var/log/marzban-watcher.log"
INSTALL_DIR="/opt/marzban-watcher"
UNINSTALL_SCRIPT="$INSTALL_DIR/uninstall.sh"
UPDATE_URL="https://raw.githubusercontent.com/ach1992/marzban-watcher/main/install.sh"

banner() {
  clear 2>/dev/null || true
  cat <<'BANNER'
============================================================
 __  __                     _                     __        __    _       _
| \/  | __ _ _ __ ______ _| |__   __ _ _ __      \ \      / /_ _| |_ ___| |__   ___ _ __
| |\/| |/ _` | '__|_  / _` | '_ \ / _` | '_ \      \ \ /\ / / _` | __/ __| '_ \ / _ \ '__|
| |  | | (_| | |   / / (_| | |_) | (_| | | | |      \ V  V / (_| | || (__| | | |  __/ |
|_|  |_|\__,_|_|  /___\__,_|_.__/ \__,_|_| |_|       \_/\_/ \__,_|\__\___|_| |_|\___|_|
============================================================
BANNER
}

ensure_root() {
  if [[ ${EUID:-$(id -u)} -ne 0 ]]; then
    echo "Please run as root."
    exit 1
  fi
}

sanitize_single_line() {
  printf '%s' "$1" | tr -d '\r\n'
}

show_latest() {
  if [[ -f "$LATEST_FILE" ]]; then
    cat "$LATEST_FILE"
  else
    echo "No latest report found yet."
  fi
}

show_hourly() {
  if [[ -f "$HOURLY_FILE" ]]; then
    tail -n 50 "$HOURLY_FILE"
  else
    echo "No hourly archive found yet."
  fi
}

show_logs() {
  if [[ -f "$LOG_FILE" ]]; then
    tail -F "$LOG_FILE"
  else
    echo "No application log found yet: $LOG_FILE"
    echo "Service fallback errors: journalctl -u $SERVICE -n 100 --no-pager"
  fi
}

live_watch() {
  watch -n 2 "cat '$LATEST_FILE' 2>/dev/null || echo 'No latest report found yet.'"
}

service_action() {
  local action="$1"
  systemctl "$action" "$SERVICE"
  systemctl status "$SERVICE" --no-pager -l || true
}

update_app() {
  ensure_root
  local tmp
  local status
  tmp="$(mktemp)"
  echo "Downloading current installer..."
  if ! curl -fsSL "$UPDATE_URL" -o "$tmp"; then
    rm -f "$tmp"
    return 1
  fi
  set +e
  bash "$tmp" --update
  status=$?
  set -e
  rm -f "$tmp"
  return "$status"
}

reconfigure() {
  ensure_root
  if [[ ! -f "$ENV_FILE" ]]; then
    echo "Env file not found: $ENV_FILE"
    exit 1
  fi
  # shellcheck disable=SC1090
  source "$ENV_FILE"

  local input
  read -r -p "Base URL [$BASE_URL]: " input
  [[ -n "$input" ]] && BASE_URL="$input"
  BASE_URL="$(printf '%s' "$BASE_URL" | sed -E 's#/[Hh][Pp][Aa][Nn][Ee][Ll]/?$##; s#/$##')"

  read -r -p "Admin username [$ADMIN_USER]: " input
  [[ -n "$input" ]] && ADMIN_USER="$(sanitize_single_line "$input")"

  read -r -s -p "Admin password [hidden, enter to keep current]: " input
  echo
  [[ -n "$input" ]] && ADMIN_PASS="$(sanitize_single_line "$input")"

  read -r -p "Refresh seconds [$REFRESH]: " input
  [[ -n "$input" ]] && REFRESH="$input"
  read -r -p "Live window [$LIVE_WINDOW]: " input
  [[ -n "$input" ]] && LIVE_WINDOW="$input"
  read -r -p "Live IP limit [$LIVE_IP_LIMIT]: " input
  [[ -n "$input" ]] && LIVE_IP_LIMIT="$input"
  read -r -p "Live connection limit [$LIVE_CONN_LIMIT]: " input
  [[ -n "$input" ]] && LIVE_CONN_LIMIT="$input"
  LIVE_TOP="${LIVE_TOP:-50}"
  read -r -p "Max rows in live report [$LIVE_TOP]: " input
  [[ -n "$input" ]] && LIVE_TOP="$input"
  read -r -p "Hourly window [$HOURLY_WINDOW]: " input
  [[ -n "$input" ]] && HOURLY_WINDOW="$input"
  read -r -p "Hourly IP limit [$HOURLY_IP_LIMIT]: " input
  [[ -n "$input" ]] && HOURLY_IP_LIMIT="$input"
  read -r -p "Hourly connection limit [$HOURLY_CONN_LIMIT]: " input
  [[ -n "$input" ]] && HOURLY_CONN_LIMIT="$input"

  LOG_MAX_MB="${LOG_MAX_MB:-64}"
  LOG_BACKUPS="${LOG_BACKUPS:-3}"
  HISTORY_MAX_MB="${HISTORY_MAX_MB:-512}"
  RECONNECT_MAX_DELAY="${RECONNECT_MAX_DELAY:-60}"
  LOG_REPEAT_SECONDS="${LOG_REPEAT_SECONDS:-300}"

  cat > "$ENV_FILE" <<ENV
BASE_URL=$(sanitize_single_line "$BASE_URL")
ADMIN_USER=$(sanitize_single_line "$ADMIN_USER")
ADMIN_PASS=$(sanitize_single_line "$ADMIN_PASS")
REFRESH=$(sanitize_single_line "$REFRESH")
LIVE_WINDOW=$(sanitize_single_line "$LIVE_WINDOW")
LIVE_IP_LIMIT=$(sanitize_single_line "$LIVE_IP_LIMIT")
LIVE_CONN_LIMIT=$(sanitize_single_line "$LIVE_CONN_LIMIT")
LIVE_TOP=$(sanitize_single_line "${LIVE_TOP:-50}")
HOURLY_WINDOW=$(sanitize_single_line "$HOURLY_WINDOW")
HOURLY_IP_LIMIT=$(sanitize_single_line "$HOURLY_IP_LIMIT")
HOURLY_CONN_LIMIT=$(sanitize_single_line "$HOURLY_CONN_LIMIT")
LOG_MAX_MB=$(sanitize_single_line "$LOG_MAX_MB")
LOG_BACKUPS=$(sanitize_single_line "$LOG_BACKUPS")
HISTORY_MAX_MB=$(sanitize_single_line "$HISTORY_MAX_MB")
RECONNECT_MAX_DELAY=$(sanitize_single_line "$RECONNECT_MAX_DELAY")
LOG_REPEAT_SECONDS=$(sanitize_single_line "$LOG_REPEAT_SECONDS")
INSECURE=$(sanitize_single_line "${INSECURE:-}")
ENV
  chmod 600 "$ENV_FILE"
  systemctl restart "$SERVICE"
  echo "Configuration updated and service restarted."
}

menu() {
  while true; do
    banner
    echo "1) Live"
    echo "2) Latest"
    echo "3) Hourly"
    echo "4) Logs"
    echo "5) Status"
    echo "6) Reconfigure"
    echo "7) Update"
    echo "8) Start"
    echo "9) Stop"
    echo "10) Restart"
    echo "11) Uninstall"
    echo "0) Exit"
    echo
    read -r -p "Select an option: " choice
    case "$choice" in
      1) live_watch ;;
      2) show_latest ;;
      3) show_hourly ;;
      4) show_logs ;;
      5) systemctl status "$SERVICE" --no-pager -l || true ;;
      6) reconfigure ;;
      7) update_app ;;
      8) ensure_root; service_action start ;;
      9) ensure_root; service_action stop ;;
      10) ensure_root; service_action restart ;;
      11)
        ensure_root
        if [[ -x "$UNINSTALL_SCRIPT" ]]; then
          "$UNINSTALL_SCRIPT"
        else
          echo "Uninstall script not found: $UNINSTALL_SCRIPT"
          exit 1
        fi
        ;;
      0) exit 0 ;;
      *) echo "Invalid choice." ;;
    esac
    echo
    read -r -p "Press Enter to continue..." _
  done
}

cmd="${1:-menu}"
case "$cmd" in
  menu) menu ;;
  live) live_watch ;;
  latest) show_latest ;;
  hourly) show_hourly ;;
  logs) show_logs ;;
  update) update_app ;;
  start|stop|restart)
    ensure_root
    service_action "$cmd"
    ;;
  status)
    systemctl status "$SERVICE" --no-pager -l || true
    ;;
  reconfigure)
    reconfigure
    ;;
  uninstall)
    ensure_root
    "$UNINSTALL_SCRIPT"
    ;;
  *)
    echo "Usage: marzban-watcher {menu|live|latest|hourly|logs|status|reconfigure|update|start|stop|restart|uninstall}"
    exit 1
    ;;
esac
